lmms_eval_specific_kwargs:
  default:
    pre_prompt: ""
    post_prompt: "\nAnswer the question using a single word or phrase."
    ocr: false
  qwen_vl:
    pre_prompt: ""
    post_prompt: " Answer:"
  plm:
    pre_prompt: ""
    post_prompt: "\nProvide a short and direct response."
